name: Generate and Upload Shorts

on:
  workflow_dispatch:
    inputs:
      youtube_url:
        description: 'Paste Long YouTube Video URL'
        required: true
        default: ''
      num_clips:
        description: 'Number of Shorts to Create'
        required: true
        default: '3'

jobs:
  build-and-upload:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout Code
      uses: actions/checkout@v4

    - name: Set up Python
      uses: actions/setup-python@v5
      with:
        python-version: '3.10'

    - name: Install Tools (FFmpeg, yt-dlp, Google API)
      run: |
        sudo apt-get update
        sudo apt-get install -y ffmpeg
        pip install yt-dlp google-api-python-client google-auth-httplib2 google-auth-oauthlib

    - name: Download and Cut Shorts
      run: |
        python -c "
        import os, yt_dlp
        
        url = '${{ github.event.inputs.youtube_url }}'
        num_clips = int('${{ github.event.inputs.num_clips }}')
        clip_duration = 40
        
        os.makedirs('output', exist_ok=True)
        raw_video = 'output/raw.mp4'
        
        # 1. Download source video
        ydl_opts = {'format': 'bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]', 'outtmpl': raw_video}
        with yt_dlp.YoutubeDL(ydl_opts) as ydl:
            ydl.download([url])
            
        # 2. Auto-crop to 9:16 vertical shorts
        for i in range(num_clips):
            start_sec = i * (clip_duration + 15)
            output_short = f'output/Short_{i+1}.mp4'
            cmd = f'ffmpeg -y -ss {start_sec} -i \"{raw_video}\" -t {clip_duration} -vf \"crop=ih*(9/16):ih\" -c:v libx264 -crf 22 -c:a copy \"{output_short}\"'
            os.system(cmd)
        "

    - name: Upload to YouTube
      env:
        CLIENT_SECRET_JSON: ${{ secrets.YOUTUBE_CLIENT_SECRET }}
      run: |
        echo "$CLIENT_SECRET_JSON" > client_secret.json
        # Add python call here to execute youtube.videos().insert API upload
